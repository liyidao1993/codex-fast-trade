# Environment
BINANCE_ENV=testnet
APP_HOST=127.0.0.1
APP_PORT=18080

# Session and local PIN auth
SESSION_SECRET=
APP_PIN=
APP_PIN_HASH=

# SQLite
DATABASE_URL=sqlite+aiosqlite:///D:/AI/JY20026/codex-fast-trade/data/app.db

# Binance endpoints
BINANCE_REST_BASE=https://demo-fapi.binance.com
BINANCE_WS_BASE=wss://stream.binancefuture.com/ws
BINANCE_RECV_WINDOW=5000

# Guard defaults
PER_ORDER_MAX_USDT=500
GLOBAL_MAX_POSITION_USDT=5000
GLOBAL_MAX_LEVERAGE=10
ALLOWED_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
FORBIDDEN_SYMBOLS=

# Optional encrypted keys are stored in SQLite later; plain keys are only for local testnet integration.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Lightweight in-process workers. Keep live execution explicit.
MONITOR_SCHEDULER_ENABLED=false
MONITOR_SCHEDULER_INTERVAL_SEC=30
STRATEGY_SCHEDULER_ENABLED=false
STRATEGY_SCHEDULER_INTERVAL_SEC=60
STRATEGY_SCHEDULER_EXECUTE=false
USER_STREAM_ENABLED=false
USER_STREAM_KEEPALIVE_SEC=1800
WORKER_ERROR_SLEEP_SEC=5

# AI provider. "mock" is local and creates drafts only; it never trades directly.
AI_PROVIDER=mock
AI_MIN_CONFIDENCE=0.65
AI_DEFAULT_QTY_USDT=50
AI_DEFAULT_TP_PCT=0.5
AI_DEFAULT_SL_PCT=0.3
